# Read-only live API E2E. GitHub Actions supplies the first two values through
# non-sensitive Repository Variables. API credentials are intentionally absent.
BUTTER_E2E_ENTRANCE=
E2E_READ_MAX_NATIVE_FEE=
E2E_READ_SOURCE_CHAIN_ID=56
E2E_READ_DESTINATION_CHAIN_ID=137
E2E_READ_FROM_TOKEN=0x0000000000000000000000000000000000000000
E2E_READ_TO_TOKEN=0x0000000000000000000000000000000000000000
E2E_READ_AMOUNT=1000000000000000
E2E_READ_MAX_NETWORK_FEE_BPS=1000
E2E_READ_MAX_PROTOCOL_FEE_BPS=1000

# Funded E2E common values. Use a dedicated low-value wallet. E2E_RECIPIENT
# must be a different address controlled by the operator.
BUTTER_ENTRANCE=
BUTTER_API_KEY_ID=
BUTTER_API_SECRET=
E2E_PRIVATE_KEY=
E2E_EXPECTED_SENDER=
E2E_RECIPIENT=
CONFIRM_EXECUTION=

# Same-chain native-token input. No funded scenario has executable defaults.
E2E_SAME_NATIVE_SOURCE_CHAIN_ID=
E2E_SAME_NATIVE_DESTINATION_CHAIN_ID=
E2E_SAME_NATIVE_SOURCE_RPC_URL=
E2E_SAME_NATIVE_DESTINATION_RPC_URL=
E2E_SAME_NATIVE_FROM_TOKEN=
E2E_SAME_NATIVE_TO_TOKEN=
E2E_SAME_NATIVE_AMOUNT=
E2E_SAME_NATIVE_MAX_INPUT=
E2E_SAME_NATIVE_MAX_NATIVE_FEE=
E2E_SAME_NATIVE_MAX_TOTAL_GAS_FEE=
E2E_SAME_NATIVE_MAX_NETWORK_FEE_BPS=
E2E_SAME_NATIVE_MAX_PROTOCOL_FEE_BPS=
E2E_SAME_NATIVE_SLIPPAGE_BPS=200

# Same-chain ERC20 input. The run must produce an approval transaction.
E2E_SAME_ERC20_SOURCE_CHAIN_ID=
E2E_SAME_ERC20_DESTINATION_CHAIN_ID=
E2E_SAME_ERC20_SOURCE_RPC_URL=
E2E_SAME_ERC20_DESTINATION_RPC_URL=
E2E_SAME_ERC20_FROM_TOKEN=
E2E_SAME_ERC20_TO_TOKEN=
E2E_SAME_ERC20_AMOUNT=
E2E_SAME_ERC20_MAX_INPUT=
E2E_SAME_ERC20_MAX_NATIVE_FEE=
E2E_SAME_ERC20_MAX_TOTAL_GAS_FEE=
E2E_SAME_ERC20_MAX_NETWORK_FEE_BPS=
E2E_SAME_ERC20_MAX_PROTOCOL_FEE_BPS=
E2E_SAME_ERC20_SLIPPAGE_BPS=200

# Cross-chain native-token input.
E2E_CROSS_NATIVE_SOURCE_CHAIN_ID=
E2E_CROSS_NATIVE_DESTINATION_CHAIN_ID=
E2E_CROSS_NATIVE_SOURCE_RPC_URL=
E2E_CROSS_NATIVE_DESTINATION_RPC_URL=
E2E_CROSS_NATIVE_FROM_TOKEN=
E2E_CROSS_NATIVE_TO_TOKEN=
E2E_CROSS_NATIVE_AMOUNT=
E2E_CROSS_NATIVE_MAX_INPUT=
E2E_CROSS_NATIVE_MAX_NATIVE_FEE=
E2E_CROSS_NATIVE_MAX_TOTAL_GAS_FEE=
E2E_CROSS_NATIVE_MAX_NETWORK_FEE_BPS=
E2E_CROSS_NATIVE_MAX_PROTOCOL_FEE_BPS=
E2E_CROSS_NATIVE_SLIPPAGE_BPS=200

# Resume an existing EVM source transaction without a private key.
E2E_STATUS_SOURCE_HASH=
E2E_STATUS_SOURCE_CHAIN_ID=
E2E_STATUS_DESTINATION_CHAIN_ID=
E2E_STATUS_SOURCE_RPC_URL=
