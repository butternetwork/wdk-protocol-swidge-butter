STATUS_BY_ORDER_ID=false
STATUS_FROM_CHAIN=
STATUS_TO_CHAIN=

# Real same-chain EVM swap example. Use a dedicated low-value account.
RPC_URL=
PRIVATE_KEY=
CONFIRM_EXECUTION=
