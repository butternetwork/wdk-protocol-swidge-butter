TOKEN_CHAIN_ID=56
DESTINATION_CHAIN_ID=137
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0x0000000000000000000000000000000000000000
FROM_TOKEN_AMOUNT=1000000000000000
